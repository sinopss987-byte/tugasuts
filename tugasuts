import java.util.Scanner;

public class Soal1 {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        String kalimat;

        System.out.print("Masukkan kalimat: ");
        kalimat = input.nextLine();

        System.out.print("Hasil terbalik: ");
        for (int i = kalimat.length() - 1; i >= 0; i--) {
            System.out.print(kalimat.charAt(i));
        }
        System.out.println();
    }
}

import java.util.Scanner;

public class Soal2 {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        String kalimat;
        char huruf;
        int jumlah = 0;

        System.out.print("Masukkan kalimat: ");
        kalimat = input.nextLine();

        System.out.print("Masukkan huruf yang dicari: ");
        huruf = input.next().charAt(0);

        for (int i = 0; i < kalimat.length(); i++) {
            if (kalimat.charAt(i) == huruf) {
                jumlah++;
            }
        }

        System.out.println("Jumlah huruf " + huruf + " adalah: " + jumlah);
    }
}

